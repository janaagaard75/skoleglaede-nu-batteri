{
  "name": "skoleglaede-nu-batteri",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.9.3",
  "scripts": {
    "android": "expo run:android",
    "build": "yarn eas build --profile production",
    "build-ios": "yarn eas build --platform ios --profile production",
    "check-lint": "eslint --format unix --max-warnings 0",
    "check-types": "tsc",
    "check-formatting": "prettier --check ./src/",
    "eas": "yarn dlx --package eas-cli --quiet eas",
    "eas-build-pre-install": "corepack enable",
    "ios": "expo run:ios",
    "optimize-icons": "npx --package imagemin-cli imagemin ./assets-src/*.png --out-dir ./assets",
    "start": "yarn install && expo start",
    "submit-ios": "yarn eas submit --platform ios --profile production",
    "test": "jest --watchAll",
    "update-dependencies": "yarn upgrade-interactive && rm yarn.lock && yarn install"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.6",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native/metro-config": "0.86.3",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.36.0",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-filename-export": "^2.0.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "6.0.0-rc1",
    "eslint-plugin-react-hooks-extra": "^1.53.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "expo": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "html-entities": "^2.6.0",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.0"
  }
}
